# HiddenAtlas Frontend Environment
# Copy to `.env` and adjust as needed.

# Backend API base URL (used when VITE_USE_MOCK_AUTH is not "true")
# VITE_API_URL=http://localhost:5000

# Frontend-only mock authentication (demo). When "true", login / signup /
# session restore use src/infrastructure/auth/mockAuth.ts and no auth
# network calls are made. Preset account: demo@hiddenatlas.com / demo1234
VITE_USE_MOCK_AUTH=true

# MapTiler API Key for vector tiles & 3D terrain elevation
# VITE_MAPTILER_API_KEY=
